rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function bootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function authDoc() {
      return get(/databases/$(database)/documents/appConfig/authorization);
    }

    function currentOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && request.auth.token.email == authDoc().data.ownerEmail;
    }

    function currentAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && (
          currentOwner()
          || (
            'adminEmails' in authDoc().data
            && request.auth.token.email in authDoc().data.adminEmails
          )
        );
    }

    match /appConfig/authorization {
      allow read: if signedIn();

      // Initial document can only be created by the permanent Owner.
      allow create: if bootstrapOwner()
        && request.resource.data.ownerEmail == 'talhakhan14746@gmail.com'
        && 'adminEmails' in request.resource.data
        && request.resource.data.adminEmails.size() >= 1
        && request.resource.data.adminEmails.size() <= 4
        && request.resource.data.adminEmails.hasAll(['talhakhan14746@gmail.com']);

      // Any Admin can manage approved-user authorization and the ON/OFF switch.
      // Only the Owner can change the Admin list.
      allow update: if currentAdmin()
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && 'adminEmails' in request.resource.data
        && request.resource.data.adminEmails.size() >= 1
        && request.resource.data.adminEmails.size() <= 4
        && request.resource.data.adminEmails.hasAll([resource.data.ownerEmail])
        && (
          currentOwner()
          || request.resource.data.adminEmails == resource.data.adminEmails
        );

      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
