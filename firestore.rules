rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function bootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function existingAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && request.auth.token.email in get(/databases/$(database)/documents/appConfig/authorization).data.adminEmails;
    }

    match /appConfig/authorization {
      allow read: if signedIn();

      // The first authorization document can only be created by the Owner.
      allow create: if bootstrapOwner()
        && request.resource.data.ownerEmail == 'talhakhan14746@gmail.com'
        && request.resource.data.adminEmails.size() >= 1
        && request.resource.data.adminEmails.size() <= 4
        && request.resource.data.adminEmails.hasAll(['talhakhan14746@gmail.com']);

      // Existing Admins may manage the Admin list and authorization list.
      // The Owner email itself cannot be changed or removed.
      allow update: if (bootstrapOwner() || existingAdmin())
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.adminEmails.size() >= 1
        && request.resource.data.adminEmails.size() <= 4
        && request.resource.data.adminEmails.hasAll([resource.data.ownerEmail]);

      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write:
        if signedIn() && request.auth.uid == userId;
    }
  }
}
