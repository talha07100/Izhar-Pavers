rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function bootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function authDoc() {
      return get(/databases/$(database)/documents/appConfig/authorization);
    }

    function currentOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && (
          (
            'ownerUid' in authDoc().data
            && authDoc().data.ownerUid != null
            && authDoc().data.ownerUid != ''
            && request.auth.uid == authDoc().data.ownerUid
          )
          ||
          (
            (!('ownerUid' in authDoc().data)
              || authDoc().data.ownerUid == null
              || authDoc().data.ownerUid == '')
            && request.auth.token.email == authDoc().data.ownerEmail
          )
        );
    }

    function currentAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && 'adminEmails' in authDoc().data
        && request.auth.token.email in authDoc().data.adminEmails;
    }

    function validAdminList(data) {
      return 'ownerEmail' in data
        && 'ownerUid' in data
        && data.ownerUid != null
        && data.ownerUid != ''
        && 'adminEmails' in data
        && data.adminEmails.size() >= 1
        && data.adminEmails.size() <= 4
        && data.adminEmails.hasAll([data.ownerEmail])
        && 'authorizedEmails' in data
        && data.authorizedEmails.hasAll([data.ownerEmail]);
    }

    match /appConfig/authorization {
      allow read: if signedIn();

      allow create: if bootstrapOwner()
        && request.resource.data.ownerEmail == 'talhakhan14746@gmail.com'
        && request.resource.data.ownerUid == request.auth.uid
        && validAdminList(request.resource.data);

      // Bootstrap owner can repair/establish the owner UID.
      allow update: if bootstrapOwner()
        && request.resource.data.ownerEmail == 'talhakhan14746@gmail.com'
        && request.resource.data.ownerUid == request.auth.uid
        && validAdminList(request.resource.data);

      // Normal Admin management: owner identity cannot be changed here.
      allow update: if currentAdmin()
        && validAdminList(request.resource.data)
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.ownerUid == resource.data.ownerUid;

      // Ownership acceptance: the signed-in Gmail must be the exact
      // requested Gmail, and both the request and authorization change
      // must happen in the same Firestore batch.
      allow update: if signedIn()
        && request.auth.token.email == request.resource.data.ownerEmail
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail != resource.data.ownerEmail
        && request.resource.data.adminEmails.hasAll([request.auth.token.email])
        && request.resource.data.authorizedEmails.hasAll([request.auth.token.email])
        && !request.resource.data.adminEmails.hasAny([resource.data.ownerEmail])
        && !request.resource.data.authorizedEmails.hasAny([resource.data.ownerEmail])
        && validAdminList(request.resource.data)
        && exists(/databases/$(database)/documents/appConfig/ownershipTransfers/$(request.auth.token.email))
        && getAfter(/databases/$(database)/documents/appConfig/ownershipTransfers/$(request.auth.token.email)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/appConfig/ownershipTransfers/$(request.auth.token.email)).data.toOwnerEmail == request.auth.token.email
        && getAfter(/databases/$(database)/documents/appConfig/ownershipTransfers/$(request.auth.token.email)).data.fromOwnerEmail == resource.data.ownerEmail
        && getAfter(/databases/$(database)/documents/appConfig/ownershipTransfers/$(request.auth.token.email)).data.fromOwnerUid == resource.data.ownerUid;

      allow delete: if false;
    }

    match /appConfig/ownershipTransfers/{targetEmail} {
      // Current Owner creates a request. No secondary login or target UID
      // is needed; the target must later sign in with this exact Gmail.
      allow create: if currentOwner()
        && targetEmail == request.resource.data.toOwnerEmail
        && request.resource.data.status == 'pending'
        && request.resource.data.fromOwnerUid == request.auth.uid
        && request.resource.data.fromOwnerEmail == request.auth.token.email
        && request.resource.data.toOwnerEmail != request.auth.token.email
        && request.resource.data.toOwnerEmail.matches('^[A-Za-z0-9._%+-]+@gmail\\.com$');

      allow read: if signedIn()
        && (
          request.auth.token.email == targetEmail
          || request.auth.uid == resource.data.fromOwnerUid
        );

      // Target Gmail accepts/rejects its own request.
      allow update: if signedIn()
        && request.auth.token.email == targetEmail
        && resource.data.toOwnerEmail == request.auth.token.email
        && resource.data.status == 'pending'
        && request.resource.data.fromOwnerEmail == resource.data.fromOwnerEmail
        && request.resource.data.fromOwnerUid == resource.data.fromOwnerUid
        && request.resource.data.toOwnerEmail == resource.data.toOwnerEmail
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
