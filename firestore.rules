rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function bootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function authDoc() {
      return get(/databases/$(database)/documents/appConfig/authorization);
    }

    function currentOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && request.auth.token.email == authDoc().data.ownerEmail;
    }

    function currentAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && 'adminEmails' in authDoc().data
        && request.auth.token.email in authDoc().data.adminEmails;
    }

    function validAdminList(data) {
      return 'ownerEmail' in data
        && 'adminEmails' in data
        && data.adminEmails.size() >= 1
        && data.adminEmails.size() <= 4
        && data.adminEmails.hasAll([data.ownerEmail]);
    }

    match /appConfig/authorization {
      allow read: if signedIn();

      // First-time creation / recovery by the permanent bootstrap Owner.
      allow create: if bootstrapOwner()
        && request.resource.data.ownerEmail == 'talhakhan14746@gmail.com'
        && validAdminList(request.resource.data);

      // Bootstrap Owner can repair/migrate the authorization document,
      // but cannot use this rule to directly change ownership.
      allow update: if bootstrapOwner()
        && request.resource.data.ownerEmail == 'talhakhan14746@gmail.com'
        && validAdminList(request.resource.data);

      allow update: if currentAdmin()
        && validAdminList(request.resource.data)
        && (
          // Normal authorization/admin changes: ownership stays unchanged.
          (
            request.resource.data.ownerEmail == resource.data.ownerEmail
            && (
              currentOwner()
              || request.resource.data.adminEmails == resource.data.adminEmails
            )
          )
          ||
          // SAFE OWNERSHIP ACCEPTANCE:
          // The existing Owner must first create a pending transfer.
          // Only the exact Gmail named in that pending request can accept it.
          (
            currentOwner()
            && request.resource.data.ownerEmail != resource.data.ownerEmail
            && request.resource.data.ownerEmail == request.auth.token.email
            && request.resource.data.ownerEmail in request.resource.data.adminEmails
            && request.resource.data.authorizedEmails.hasAll([request.resource.data.ownerEmail])
            && 'pendingOwnershipTransfer' in resource.data
            && resource.data.pendingOwnershipTransfer.status == 'pending'
            && resource.data.pendingOwnershipTransfer.email == request.auth.token.email
            && request.resource.data.pendingOwnershipTransfer == null
          )
        );

      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
