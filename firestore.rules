rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authDoc() {
      return /databases/$(database)/documents/appConfig/authorization;
    }

    function hasAuthConfig() {
      return exists(authDoc());
    }

    function isBootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function isAdmin() {
      return signedIn()
        && hasAuthConfig()
        && (
          request.auth.token.email == get(authDoc()).data.ownerEmail
          ||
          (
            get(authDoc()).data.adminEmails is list
            && request.auth.token.email in get(authDoc()).data.adminEmails
          )
        );
    }

    function appAccessAllowed() {
      return signedIn()
        && (
          !hasAuthConfig()
          || isAdmin()
          || get(authDoc()).data.enabled != true
          || request.auth.token.email in get(authDoc()).data.authorizedEmails
        );
    }

    // ==============================
    // ADMIN / AUTHORIZATION
    // ==============================
    match /appConfig/authorization {
      allow read: if signedIn();

      // First creation can only be performed by the permanent bootstrap Owner.
      allow create: if isBootstrapOwner() && !hasAuthConfig();

      // Existing Owner/Admin can update authorization and admin list.
      allow update: if isAdmin();

      // Authorization config must never be deleted.
      allow delete: if false;
    }

    // ==============================
    // TERMS & CONDITIONS
    // ==============================
    // There is NO Terms Lock. Any signed-in app user may read/write Terms.
    // This matches the application requirement that Terms editing has no
    // Owner/Admin restriction.
    match /appConfig/terms {
      allow read, create, update, delete: if signedIn();
    }

    // ==============================
    // USER DATA
    // ==============================
    match /users/{userId}/{document=**} {
      allow read, write:
        if signedIn()
        && request.auth.uid == userId
        && appAccessAllowed();
    }
  }
}
