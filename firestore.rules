rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authDoc() {
      return /databases/$(database)/documents/appConfig/authorization;
    }

    function hasAuthConfig() {
      return exists(authDoc());
    }

    function isBootstrapOwner() {
      return request.auth != null
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function isCurrentOwner() {
      return request.auth != null
        && (
          (!hasAuthConfig() && isBootstrapOwner())
          || (hasAuthConfig()
              && request.auth.token.email == get(authDoc()).data.ownerEmail)
        );
    }

    function appAccessAllowed() {
      return request.auth != null
        && (
          !hasAuthConfig()
          || isCurrentOwner()
          || get(authDoc()).data.enabled != true
          || request.auth.token.email in get(authDoc()).data.authorizedEmails
        );
    }

    match /appConfig/authorization {
      // Signed-in users may read the authorization state so the app can decide access.
      allow read: if request.auth != null;

      // The original bootstrap owner creates the configuration the first time.
      allow create: if isBootstrapOwner() && !hasAuthConfig();

      // Only the current admin can change authorization or ownership.
      allow update: if isCurrentOwner();
      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write:
        if request.auth != null
        && request.auth.uid == userId
        && appAccessAllowed();
    }
  }
}
