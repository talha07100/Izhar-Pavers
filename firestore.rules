rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function authDoc() {
      return /databases/$(database)/documents/appConfig/authorization;
    }

    function termsDoc() {
      return /databases/$(database)/documents/appConfig/terms;
    }

    function hasAuthConfig() {
      return exists(authDoc());
    }

    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function isCurrentAdmin() {
      return signedIn()
        && hasAuthConfig()
        && (
          (
            get(authDoc()).data.adminEmails is list
            && request.auth.token.email in get(authDoc()).data.adminEmails
          )
          || request.auth.token.email == get(authDoc()).data.ownerEmail
        );
    }

    function termsEditingUnlocked() {
      return signedIn()
        && (!hasAuthConfig() || get(authDoc()).data.termsLocked != true);
    }

    function appAccessAllowed() {
      return signedIn()
        && (
          !hasAuthConfig()
          || isCurrentAdmin()
          || get(authDoc()).data.enabled != true
          || request.auth.token.email in get(authDoc()).data.authorizedEmails
        );
    }

    match /appConfig/authorization {
      allow read: if signedIn();
      allow create: if isBootstrapOwner() && !hasAuthConfig();
      allow update: if isCurrentAdmin();
      allow delete: if false;
    }

    // Shared Terms & Conditions configuration.
    // Everyone signed in can read it. Admins can always write.
    // Normal signed-in/authorized users can write only while the Admin lock is OFF.
    match /appConfig/terms {
      allow read: if signedIn();
      allow create, update: if isCurrentAdmin() || termsEditingUnlocked();
      allow delete: if isCurrentAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write:
        if signedIn()
        && request.auth.uid == userId
        && appAccessAllowed();
    }
  }
}
