rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function bootstrapOwner() {
      return verifiedEmail()
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function authDoc() {
      return get(/databases/$(database)/documents/appConfig/authorization);
    }

    // The verified Google email is the primary owner identity.
    // ownerUid is also checked when it is present, but a stale/missing UID
    // cannot lock the real verified owner out of creating a transfer request.
    function currentOwner() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && request.auth.token.email == authDoc().data.ownerEmail
        && (
          !('ownerUid' in authDoc().data)
          || authDoc().data.ownerUid == null
          || authDoc().data.ownerUid == ''
          || request.auth.uid == authDoc().data.ownerUid
        );
    }

    function currentAdmin() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && 'adminEmails' in authDoc().data
        && request.auth.token.email in authDoc().data.adminEmails;
    }

    function validAdminList(data) {
      return 'ownerEmail' in data
        && 'ownerUid' in data
        && data.ownerUid != null
        && data.ownerUid != ''
        && 'adminEmails' in data
        && data.adminEmails.size() >= 1
        && data.adminEmails.size() <= 4
        && data.adminEmails.hasAll([data.ownerEmail])
        && 'authorizedEmails' in data
        && data.authorizedEmails.hasAll([data.ownerEmail]);
    }

    match /appConfig/authorization {

      allow read: if verifiedEmail();

      // Initial owner setup.
      allow create: if bootstrapOwner()
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.ownerUid == request.auth.uid
        && validAdminList(request.resource.data);

      // Bootstrap owner can repair a missing/stale UID.
      allow update: if bootstrapOwner()
        && resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.ownerUid == request.auth.uid
        && validAdminList(request.resource.data);

      // Normal admin changes. Owner identity cannot be changed here.
      allow update: if currentAdmin()
        && validAdminList(request.resource.data)
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.ownerUid == resource.data.ownerUid;

      // New Owner accepts. The authorization update and transfer-request
      // update must happen together in the same Firestore batch.
      allow update: if verifiedEmail()
        && request.auth.token.email == request.resource.data.ownerEmail
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail != resource.data.ownerEmail
        && request.resource.data.adminEmails.hasAll([request.auth.token.email])
        && request.resource.data.authorizedEmails.hasAll([request.auth.token.email])
        && !request.resource.data.adminEmails.hasAny([resource.data.ownerEmail])
        && !request.resource.data.authorizedEmails.hasAny([resource.data.ownerEmail])
        && validAdminList(request.resource.data)
        && exists(/databases/$(database)/documents/ownershipTransfers/$(request.auth.token.email))
        && getAfter(/databases/$(database)/documents/ownershipTransfers/$(request.auth.token.email)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/ownershipTransfers/$(request.auth.token.email)).data.toOwnerEmail == request.auth.token.email
        && getAfter(/databases/$(database)/documents/ownershipTransfers/$(request.auth.token.email)).data.fromOwnerEmail == resource.data.ownerEmail
        && getAfter(/databases/$(database)/documents/ownershipTransfers/$(request.auth.token.email)).data.fromOwnerUid != null;

      // Never delete the authorization document from the client.
      allow delete: if false;
    }

    match /ownershipTransfers/{targetEmail} {

      // The current verified Owner creates a request.
      // The same Owner may also safely refresh/replace an existing pending
      // request for the same target Gmail. This prevents a second request
      // from failing with "Missing or insufficient permissions" when the
      // target document already exists.
      allow create: if currentOwner()
        && targetEmail == request.resource.data.toOwnerEmail
        && request.resource.data.status == 'pending'
        && request.resource.data.fromOwnerUid == request.auth.uid
        && request.resource.data.fromOwnerEmail == request.auth.token.email
        && request.resource.data.toOwnerEmail != request.auth.token.email
        && request.resource.data.toOwnerEmail.matches('^[A-Za-z0-9._%+-]+@gmail\\.com$');

      // Existing pending request may be refreshed only by the same current
      // Owner. It cannot be changed into accepted/rejected by the Owner.
      allow update: if currentOwner()
        && resource.data.status == 'pending'
        && targetEmail == resource.data.toOwnerEmail
        && request.resource.data.status == 'pending'
        && request.resource.data.fromOwnerUid == request.auth.uid
        && request.resource.data.fromOwnerEmail == request.auth.token.email
        && request.resource.data.toOwnerEmail == resource.data.toOwnerEmail
        && request.resource.data.toOwnerEmail == targetEmail;

      // Only the target Gmail or the requesting Owner can see the request.
      allow read: if verifiedEmail()
        && (
          request.auth.token.email == targetEmail
          || request.auth.uid == resource.data.fromOwnerUid
        );

      // Only the target Gmail can accept/reject its pending request.
      allow update: if verifiedEmail()
        && request.auth.token.email == targetEmail
        && resource.data.toOwnerEmail == request.auth.token.email
        && resource.data.status == 'pending'
        && request.resource.data.fromOwnerEmail == resource.data.fromOwnerEmail
        && request.resource.data.fromOwnerUid == resource.data.fromOwnerUid
        && request.resource.data.toOwnerEmail == resource.data.toOwnerEmail
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }
  }
}
