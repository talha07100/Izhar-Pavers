rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function bootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function authDoc() {
      return get(/databases/$(database)/documents/appConfig/authorization);
    }

    function currentOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && (
          ('ownerUid' in authDoc().data && authDoc().data.ownerUid != null && request.auth.uid == authDoc().data.ownerUid)
          ||
          ((!('ownerUid' in authDoc().data) || authDoc().data.ownerUid == null || authDoc().data.ownerUid == '')
            && request.auth.token.email == authDoc().data.ownerEmail)
        );
    }

    function currentAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && 'adminEmails' in authDoc().data
        && request.auth.token.email in authDoc().data.adminEmails;
    }

    function validAdminList(data) {
      return 'ownerEmail' in data
        && 'adminEmails' in data
        && data.adminEmails.size() >= 1
        && data.adminEmails.size() <= 4
        && data.adminEmails.hasAll([data.ownerEmail]);
    }

    match /appConfig/authorization {
      allow read: if signedIn();

      // Permanent bootstrap recovery. Once ownerUid exists, normal Owner control
      // is bound to the authenticated Firebase UID instead of a typed email.
      allow create: if bootstrapOwner()
        && request.resource.data.ownerEmail == 'talhakhan14746@gmail.com'
        && validAdminList(request.resource.data);

      allow update: if bootstrapOwner()
        && request.resource.data.ownerEmail == 'talhakhan14746@gmail.com'
        && validAdminList(request.resource.data)
        && (
          !('ownerUid' in resource.data)
          || resource.data.ownerUid == null
          || resource.data.ownerUid == ''
          || request.resource.data.ownerUid == request.auth.uid
        );

      // Existing Owner/Admin accounts may update authorization/admin data.
      // Only the current Owner may change ownerEmail/ownerUid, and the new
      // owner must be explicitly present in both Admin and Authorized lists.
      allow update: if currentAdmin()
        && validAdminList(request.resource.data)
        && (
          (
            request.resource.data.ownerEmail == resource.data.ownerEmail
            && request.resource.data.ownerUid == resource.data.ownerUid
            && (
              currentOwner()
              || request.resource.data.adminEmails == resource.data.adminEmails
            )
          )
          ||
          (
            currentOwner()
            && request.resource.data.ownerEmail != resource.data.ownerEmail
            && 'ownerUid' in request.resource.data
            && request.resource.data.ownerUid != null
            && request.resource.data.ownerUid != ''
            && request.resource.data.ownerEmail in request.resource.data.adminEmails
            && request.resource.data.ownerEmail in request.resource.data.authorizedEmails
          )
        );

      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
