rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function bootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'talhakhan14746@gmail.com';
    }

    function authDoc() {
      return get(/databases/$(database)/documents/appConfig/authorization);
    }

    function currentOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && request.auth.token.email == authDoc().data.ownerEmail;
    }

    function currentAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/authorization)
        && 'adminEmails' in authDoc().data
        && request.auth.token.email in authDoc().data.adminEmails;
    }

    function validAdminList(data) {
      return 'adminEmails' in data
        && data.adminEmails.size() >= 1
        && data.adminEmails.size() <= 4
        && data.adminEmails.hasAll([data.ownerEmail]);
    }

    match /appConfig/authorization {
      allow read: if signedIn();

      allow create: if bootstrapOwner()
        && request.resource.data.ownerEmail == 'talhakhan14746@gmail.com'
        && validAdminList(request.resource.data);

      allow update: if currentAdmin()
        && validAdminList(request.resource.data)
        && (
          // Normal Admin/Authorization changes: Owner stays the same and only
          // an Admin may change authorization data.
          (request.resource.data.ownerEmail == resource.data.ownerEmail
            && (currentOwner() || request.resource.data.adminEmails == resource.data.adminEmails))
          ||
          // Ownership transfer: ONLY the current Owner may change ownerEmail.
          // The new Owner must already be an Admin and the old Owner must be
          // removed from the Admin list. The new Owner is kept authorized.
          (currentOwner()
            && request.resource.data.ownerEmail != resource.data.ownerEmail
            && request.resource.data.ownerEmail in request.resource.data.adminEmails
            && !(resource.data.ownerEmail in request.resource.data.adminEmails)
            && request.resource.data.authorizedEmails.hasAll([request.resource.data.ownerEmail]))
        );

      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
